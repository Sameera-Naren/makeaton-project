// ============================================================
// Prisma Schema – Brightloop Software Subscription System
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// STUB MODELS – Owned by Member 1 (Auth & Customer Portal)
// These are minimal stubs. Member 1 will expand these.
// Do NOT modify these models without coordinating with Member 1.
// ============================================================

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(STAFF)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  customer     Customer?

  @@map("users")
}

model Customer {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  companyName String
  phone       String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations owned by Member 3
  quotations    Quotation[]
  subscriptions Subscription[]

  @@map("customers")
}

// ============================================================
// STUB MODELS – Owned by Member 2 (Products, Plans & Discounts)
// These are minimal stubs. Member 2 will expand these.
// Do NOT modify these models without coordinating with Member 2.
// ============================================================

enum BillingFrequency {
  MONTHLY
  YEARLY
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants         ProductVariant[]
  quotationItems   QuotationItem[]
  subscriptionItems SubscriptionItem[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  name      String
  price     Decimal  @db.Decimal(12, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotationItems    QuotationItem[]
  subscriptionItems SubscriptionItem[]

  @@map("product_variants")
}

model Plan {
  id               String           @id @default(cuid())
  name             String
  billingFrequency BillingFrequency
  description      String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  quotationItems    QuotationItem[]
  subscriptionItems SubscriptionItem[]

  @@map("plans")
}

// ============================================================
// MEMBER 3 MODELS – Quotations & Subscription Management
// ============================================================

enum QuotationStatus {
  DRAFT
  CONFIRMED
  CONVERTED
  EXPIRED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CLOSED
  EXPIRED
}

// ------ Quotation ------

model Quotation {
  id              String          @id @default(cuid())
  quotationNumber String          @unique
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id])
  status          QuotationStatus @default(DRAFT)
  discountPct     Decimal         @default(0) @db.Decimal(5, 2) // overall discount %
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  notes           String?
  expiresAt       DateTime?
  confirmedAt     DateTime?
  convertedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items        QuotationItem[]
  subscription Subscription?   // one-to-one: prevents duplicate conversion

  @@map("quotations")
}

model QuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  productId   String
  product     Product        @relation(fields: [productId], references: [id])
  variantId   String?
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  planId      String
  plan        Plan           @relation(fields: [planId], references: [id])

  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2)  // price snapshot at time of quotation
  discountPct Decimal  @default(0) @db.Decimal(5, 2)
  subtotal    Decimal  @db.Decimal(12, 2)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("quotation_items")
}

// ------ Subscription ------

model Subscription {
  id                String             @id @default(cuid())
  subscriptionRef   String             @unique
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  quotationId       String             @unique // prevents duplicate conversion
  quotation         Quotation          @relation(fields: [quotationId], references: [id])
  status            SubscriptionStatus @default(ACTIVE)
  billingFrequency  BillingFrequency
  startDate         DateTime           @default(now())
  endDate           DateTime?
  renewalDate       DateTime?
  pausedAt          DateTime?
  closedAt          DateTime?
  totalAmount       Decimal            @db.Decimal(12, 2)
  notes             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items SubscriptionItem[]

  @@map("subscriptions")
}

model SubscriptionItem {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  variantId      String?
  variant        ProductVariant? @relation(fields: [variantId], references: [id])
  planId         String
  plan           Plan           @relation(fields: [planId], references: [id])

  quantity         Int
  agreedUnitPrice  Decimal  @db.Decimal(12, 2) // price locked at conversion time
  subtotal         Decimal  @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("subscription_items")
}
